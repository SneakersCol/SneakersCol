    <!-- JAVASCRIPT -->

    <script>

        /* =========================
           VARIABLES
        ========================= */

        let sambaColor = "Blanco";
        let vomeroColor = "Beige/Rosa";

        let tallaNewBalance = "";
        let tallaSamba = "";
        let tallaVomero = "";


        /* =========================
           NEW BALANCE FOTOS
        ========================= */

        function cambiarNewBalance(imagen) {

            document.getElementById("newbalance-img").src =
                "imagenes/" + imagen;

        }


        /* =========================
           SAMBA
        ========================= */

        function cambiarSamba(imagen, color, boton) {

            document.getElementById("samba-img").src =
                "imagenes/" + imagen;

            sambaColor = color;

            const botones =
                document.querySelectorAll(".producto:nth-child(2) .color-btn");

            botones.forEach(function(b) {
                b.classList.remove("seleccionado");
            });

            boton.classList.add("seleccionado");

        }


        /* =========================
           VOMERO
        ========================= */

        function cambiarVomero(imagen, color, boton) {

            document.getElementById("vomero-img").src =
                "imagenes/" + imagen;

            vomeroColor = color;

            const botones =
                document.querySelectorAll(".producto:nth-child(3) .color-btn");

            botones.forEach(function(b) {
                b.classList.remove("seleccionado");
            });

            boton.classList.add("seleccionado");

        }


        /* =========================
           SELECCIONAR TALLA
        ========================= */

        function seleccionarTalla(producto, talla, boton) {

            const contenedor =
                boton.parentElement;

            const botones =
                contenedor.querySelectorAll(".talla");

            botones.forEach(function(b) {
                b.classList.remove("seleccionada");
            });

            boton.classList.add("seleccionada");


            if (producto === "newbalance") {

                tallaNewBalance = talla;

                document.getElementById("talla-newbalance").innerText =
                    "✓ Talla seleccionada: " + talla;

            }


            if (producto === "samba") {

                tallaSamba = talla;

                document.getElementById("talla-samba").innerText =
                    "✓ Talla seleccionada: " + talla;

            }


            if (producto === "vomero") {

                tallaVomero = talla;

                document.getElementById("talla-vomero").innerText =
                    "✓ Talla seleccionada: " + talla;

            }

        }


        /* =========================
           WHATSAPP
        ========================= */

        function comprarWhatsApp(producto, color, talla) {

            const numero =
                "573209925066";


            if (
                producto !== "SneakersCol" &&
                (!talla || talla === "")
            ) {

                alert(
                    "👟 ¡Selecciona una talla antes de continuar!"
                );

                return;

            }


            let mensaje =
                "Hola 👋 Estoy interesado en comprar en SneakersCol.%0A%0A" +
                "👟 Producto: " + producto;


            if (color && color !== "") {

                mensaje +=
                    "%0A🎨 Color: " + color;

            }


            if (talla && talla !== "") {

                mensaje +=
                    "%0A📏 Talla: " + talla;

            }


            mensaje +=
                "%0A💰 Precio: consultar" +
                "%0A🚚 Envío GRATIS a todo Colombia 🇨🇴" +
                "%0A%0A¿Me pueden ayudar con la compra?";


            const url =
                "https://wa.me/" +
                numero +
                "?text=" +
                mensaje;


            window.open(url, "_blank");

        }

    </script>

